{
  // Talay website. De gewone site staat in /public.
  // /b/ (boekingspagina), /r/ (bronlinks voor outreach), /zone (klantenzone) en /api (demoformulier) gaan naar src/index.js.
  "name": "snowy-sun-ea23",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/b/*", "/r/*", "/zone", "/zone/*", "/api/*"]
  },
  "vars": {
    "AIRTABLE_BASE": "appEXBMOJa73WiQHb",
    // respond.io channel of Talay's own WhatsApp number (+32 456 95 39 07): notifications to center staff.
    "NOTIFY_CHANNEL": "570715"
  },
  "observability": { "enabled": true },
  // Talay HQ: elke 15 minuten nakijken of er een melding nodig is (src/zone.js → runHqAlerts).
  "triggers": { "crons": ["*/15 * * * *"] }
  // De Airtable-sleutel staat als geheim AIRTABLE_TOKEN in Cloudflare, nooit hier.
}
