    --red:#EF4A55; --red-soft:#3A1A1E; --teal:#62B6C0; --teal-soft:#16343A; --ok:#5CC98A; --ok-soft:#163323; --warn:#F0B44C; --warn-soft:#3A2C12;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --surface:#0C181B; --card:#132428; --ink:#E4EEEF; --muted:#9AB0B4; --line:#25393E;
  --red:#EF4A55; --red-soft:#3A1A1E; --teal:#62B6C0; --teal-soft:#16343A; --ok:#5CC98A; --ok-soft:#163323; --warn:#F0B44C; --warn-soft:#3A2C12;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--surface);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.5}
.wrap{max-width:920px;margin:0 auto;padding:20px 16px 64px}
h1,h2,h3{font-family:var(--cond);line-height:1.1;margin:0}
h1{font-size:clamp(2rem,6vw,3rem);font-weight:700;letter-spacing:.01em}
h2{font-size:1.6rem;font-weight:600;margin:40px 0 12px}
h3{font-size:1.2rem;font-weight:600}
p{margin:0 0 10px}
button,select,input,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px}

/* Kop met duikvlag */
.hero{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:center;margin-bottom:8px}
.flag{width:74px;height:52px;border-radius:4px;background:var(--red);position:relative;overflow:hidden;flex:none}
.flag::after{content:"";position:absolute;left:-20%;top:42%;width:140%;height:16%;background:#fff;transform:rotate(-35deg)}
.sub{color:var(--muted);margin-top:6px}
.clock{margin-top:18px;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--card);display:flex;flex-wrap:wrap;gap:6px 14px;align-items:baseline}
.clock strong{font-family:var(--cond);font-size:1.5rem}
.clock.go{border-color:var(--ok);background:var(--ok-soft)}
.clock .hint{color:var(--muted)}
.clock.go .hint{color:var(--ok);font-weight:600}

/* Wie */
.who{display:flex;gap:8px;margin:22px 0 4px;flex-wrap:wrap}
.who button{flex:1 1 140px;padding:12px 14px;border-radius:10px;border:2px solid var(--line);background:var(--card);cursor:pointer;text-align:left}
.who button[aria-pressed="true"]{border-color:var(--teal);background:var(--teal-soft)}
.who .nm{font-family:var(--cond);font-size:1.35rem;font-weight:600;display:block}
.who .pg{color:var(--muted);font-size:.9rem}
.bar{height:6px;border-radius:3px;background:var(--line);margin-top:8px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--teal);width:0;transition:width .3s}

.banner{margin:14px 0;padding:10px 14px;border-radius:8px;background:var(--warn-soft);color:var(--warn);font-size:.95rem}
.banner.ok{background:var(--ok-soft);color:var(--ok)}

/* Checklist */
.check{list-style:none;margin:0;padding:0;border:1px solid var(--line);border-radius:10px;background:var(--card)}
.check li{border-top:1px solid var(--line)}
.check li:first-child{border-top:0}
.check label{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:12px 14px;cursor:pointer;align-items:start}
.check input[type=checkbox]{width:22px;height:22px;margin:1px 0 0;accent-color:var(--teal)}
.check small{display:block;color:var(--muted)}
.check input:checked + span{color:var(--muted)}
.check input:checked + span b{text-decoration:line-through}

.rules{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-top:10px}
.rule{padding:12px 14px;border-left:4px solid var(--red);background:var(--card);border-radius:0 8px 8px 0}
.rule b{display:block;font-family:var(--cond);font-size:1.15rem;font-weight:600}

/* Leads */
.night{font-family:var(--cond);font-size:1.15rem;font-weight:600;color:var(--muted);margin:22px 0 8px}
.lead{background:var(--card);border:1px solid var(--line);border-radius:10px;margin-bottom:10px}
.lead>summary{list-style:none;cursor:pointer;padding:12px 14px;display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:center}
.lead>summary::-webkit-details-marker{display:none}
.lead .ln{font-weight:600;font-size:1.05rem}
.lead .meta{color:var(--muted);font-size:.9rem;grid-column:1}
.lead .contact{grid-column:1;font-size:1rem;user-select:text;-webkit-user-select:text}
.lead .contact b{font-family:var(--cond);font-size:1.15rem;font-weight:600;letter-spacing:.02em;color:var(--teal)}
.search{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);font-size:1rem;margin:4px 0 6px}
.state{grid-row:1/4;grid-column:2;font-size:.85rem;font-weight:600;padding:4px 10px;border-radius:99px;background:var(--line);color:var(--ink);white-space:nowrap}
.state.s1{background:var(--warn-soft);color:var(--warn)}
.state.s2{background:var(--teal-soft);color:var(--teal)}
.state.s3{background:var(--ok-soft);color:var(--ok)}
.state.due{background:var(--red-soft);color:var(--red)}
.lead[open]>summary{border-bottom:1px solid var(--line)}
.body{padding:6px 14px 16px}
.step{display:grid;grid-template-columns:30px 1fr;gap:10px;padding:12px 0;border-top:1px dashed var(--line)}
.step:first-child{border-top:0}
.num{width:26px;height:26px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-family:var(--cond);font-weight:700;font-size:.95rem;color:var(--muted)}
.step.done .num{background:var(--teal);border-color:var(--teal);color:#fff}
.step h4{margin:2px 0 6px;font-size:1rem}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.btn{padding:8px 12px;border-radius:8px;border:1px solid var(--line);background:var(--surface);cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;font-weight:500}
.btn.primary{background:var(--teal);border-color:var(--teal);color:#fff}
.btn:hover{filter:brightness(.97)}
.stamp{font-weight:600}
.muted{color:var(--muted);font-size:.9rem}
input[type=datetime-local],select,textarea{padding:7px 9px;border:1px solid var(--line);border-radius:8px;background:var(--card);max-width:100%}
textarea{width:100%;min-height:60px;resize:vertical}
.msg{background:var(--surface);border-radius:8px;padding:10px 12px;margin:6px 0 8px;font-size:.95rem;white-space:pre-wrap}
.pill{display:inline-block;font-size:.8rem;padding:2px 8px;border-radius:99px;background:var(--surface);border:1px solid var(--line);margin-right:4px}
.pill.late{background:var(--red-soft);border-color:transparent;color:var(--red);font-weight:600}
.pill.okp{background:var(--ok-soft);border-color:transparent;color:var(--ok)}
.chk{display:flex;gap:8px;align-items:center;margin:4px 0;cursor:pointer}
.chk input{width:20px;height:20px;accent-color:var(--teal)}

/* Resultaten */
.res{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
