function clock(){
  const now=new Date();
  const parts=new Intl.DateTimeFormat("en-GB",{timeZone:TZ,hour:"2-digit",minute:"2-digit",hour12:false}).format(now).split(":").map(Number);
  const m=parts[0]*60+parts[1]; const go=m>=20*60+30&&m<=22*60+30;
  const el=document.getElementById("clock");
  el.className="clock"+(go?" go":"");
  el.innerHTML="";
  const a=document.createElement("strong");a.textContent=fmtT.format(now)+" in Koh Tao";
  const b=document.createElement("span");b.className="muted";b.textContent=fmtLocal.format(now)+" bij jou";
  const c=document.createElement("span");c.className="hint";
  if(go) c.textContent="Goed moment om te sturen.";
