const queue={}; // per document: één write tegelijk
function persist(path,data){
  saveLocal();
  if(!shared||readOnly) return;
  const q=queue[path]||(queue[path]={busy:false,next:null});
  q.next=data;
  if(q.busy) return;
  const run=async()=>{
    q.busy=true;
    while(q.next){const d=q.next;q.next=null;
      try{await db.doc(path).set(d);markSaved();}
      catch(e){
        if(e&&e.code==="invalid_argument"){readOnly=true;showBanner("Je kan deze pagina bekijken, maar niet bewerken. Vraag Jonas om je als bewerker uit te nodigen. Wat je aantikt, blijft voorlopig alleen in deze browser.");break;}
        else if(e&&e.code==="unavailable"){await new Promise(r=>setTimeout(r,800+Math.random()*800));q.next=q.next||d;}
        else {showBanner("Opslaan lukte niet ("+(e&&e.code||"fout")+"). Je wijzigingen staan wel in deze browser.");break;}
      }}
    q.busy=false;
  };
  run();
}
