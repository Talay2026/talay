(async()=>{
  if(!window.claude||!window.claude.use){showBanner("Je wijzigingen worden alleen in deze browser bewaard.");return;}
  const d=await window.claude.use("db");
  if(!d){showBanner("Je wijzigingen worden alleen in deze browser bewaard. Open de pagina via de gedeelde Claude-link om samen in één lijst te werken.");return;}
  db=d; shared=true; document.getElementById("savestate").textContent="Alles wat je aantikt, wordt meteen gedeeld opgeslagen.";
  try{const u=await window.claude.use("user"); if(u&&u.can){const w=await u.can("data.write"); if(w===false){readOnly=true;showBanner("Je kan deze pagina bekijken, maar niet bewerken. Vraag Jonas om je als bewerker uit te nodigen.");}}}catch(e){}
  db.collection("leads").onSnapshot(snap=>{
    for(const doc of snap.docs){ if(doc.exists){ const q=queue["leads/"+doc.id]; if(q&&(q.busy||q.next)) continue; state.leads[doc.id]={...doc.data()}; } }
    saveLocal(); safeRender();
  },()=>{});
  db.collection("prep").onSnapshot(snap=>{
    for(const doc of snap.docs){ if(doc.exists){ const q=queue["prep/"+doc.id]; if(q&&(q.busy||q.next)) continue; state.prep[doc.id]={...doc.data()}; } }
    saveLocal(); safeRender();
  },()=>{});
})();
