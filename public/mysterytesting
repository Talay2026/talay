function markSaved(){const e=document.getElementById("savestate");if(e)e.textContent="Gedeeld opgeslagen om "+fmtLocal.format(new Date())+".";}
function csvTime(iso){if(!iso)return "";const v=toInput(iso);return v.slice(8,10)+"/"+v.slice(5,7)+"/"+v.slice(0,4)+" "+v.slice(11,16);}
function csvH(a,b){if(!a||!b)return "";return (Math.round(hours(a,b)*100)/100).toString().replace(".",",");}
function yesno(v){return v===true?"Ja":v===false?"Nee":"";}
function buildCSV(){
  const head=["Tester","Center","Gebied","Taal","Kanaal","Nummer of account","Verzonden (Thaise tijd)","Automatisch bericht?","Automatisch om","Automatisch na (uren)","Echt antwoord om","Antwoordtijd (uren)","Tussen automatisch en echt (uren)","Wie antwoordde","Prijs gegeven","Beschikbaarheid bevestigd","Boekingslink of betaalwijze","Follow-up 1","Follow-up 2","Aantal follow-ups","Afgesloten","Screenshots bewaard","Notities"];
  const rows=LEADS.map(l=>{const s=L(l.id);return [NAMES[l.who],l.name,l.area||"",l.lang,l.channel==="wa"?"WhatsApp":"Instagram",handle(l),csvTime(s.sent),yesno(s.auto),csvTime(s.autoAt),csvH(s.sent,s.autoAt),csvTime(s.reply),csvH(s.sent,s.reply),s.auto?csvH(s.autoAt,s.reply):"",s.type||"",yesno(s.price),yesno(s.avail),s.link||"",csvTime(s.fu1),csvTime(s.fu2),(s.fu1?1:0)+(s.fu2?1:0),s.closed?"Ja":"",s.shots?"Ja":"",(s.notes||"").replace(/\s+/g," ")];});
  const esc=v=>{v=String(v);return /[;"\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v;};
  return "\ufeff"+[head,...rows].map(r=>r.map(esc).join(";")).join("\r\n");
}
(async()=>{
  if(!window.claude||!window.claude.use) return;
  const dl=await window.claude.use("downloads"); if(!dl) return;
  const b=document.getElementById("exp"); b.hidden=false;
  b.addEventListener("click",async()=>{
    const d=new Date(); const stamp=d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
    try{const r=await dl.save({filename:"mystery-shop-koh-tao-"+stamp+".csv",data:buildCSV()}); if(r&&r.status==="saved"){const o=b.textContent;b.textContent="Gedownload";setTimeout(()=>b.textContent=o,1800);}}
    catch(e){ if(e&&e.code==="unavailable") b.hidden=true; }
  });
})();

